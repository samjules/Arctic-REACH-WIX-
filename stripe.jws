// backend/stripe.jsw
import { fetch } from 'wix-fetch';

const STRIPE_SECRET_KEY = "";

export async function createCheckoutSession(clientId, topUpAmount) {
    console.log("Backend: createCheckoutSession called");
    console.log("Client ID:", clientId);
    console.log("Top-up Amount:", topUpAmount);

    const amountInCents = Math.round(topUpAmount * 100);

    const body = {
        payment_method_types: ['card'],
        line_items: [
            {
                price_data: {
                    currency: 'usd',
                    product_data: {
                        name: 'Lead Top-Up',
                        metadata: { clientId }
                    },
                    unit_amount: amountInCents
                },
                quantity: 1
            }
        ],
        mode: 'payment',
        success_url: `https://www.arctic-reach.com/success`,
        cancel_url: `https://www.arctic-reach.com/cancel`,
        metadata: { clientId }
    };

    try {
        console.log("Sending request to Stripe API...");
        console.log("Flattened body:", flattenObject(body));
        
        const response = await fetch('https://api.stripe.com/v1/checkout/sessions', {
            method: 'POST',
            headers: {
                "Authorization": `Bearer ${STRIPE_SECRET_KEY}`,
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: new URLSearchParams(flattenObject(body))
        });

        const data = await response.json();
        console.log("Stripe response:", JSON.stringify(data));

        if (data.error) {
            // Stripe returned an error
            throw new Error(`Stripe error: ${data.error.message}`);
        }

        if (!data.url) {
            throw new Error("No checkout URL returned from Stripe.");
        }

        console.log("Returning checkout URL to frontend:", data.url);
        return data.url;

    } catch (err) {
        console.error("Error creating Stripe session:", err);
        throw err;
    }
}

// Flatten nested objects/arrays for URLSearchParams (Stripe format)
function flattenObject(obj, parentKey = '', result = {}) {
    for (let key in obj) {
        if (!obj.hasOwnProperty(key)) continue;
        
        const value = obj[key];
        const fullKey = parentKey ? `${parentKey}[${key}]` : key;

        if (value === null || value === undefined) {
            // Skip null/undefined values
            continue;
        } else if (Array.isArray(value)) {
            // For arrays, check if items are primitives or objects
            value.forEach((item, index) => {
                if (typeof item === 'object' && item !== null && !Array.isArray(item)) {
                    // For objects in arrays, use indexed keys: key[0][subkey]
                    const arrayKey = `${fullKey}[${index}]`;
                    flattenObject(item, arrayKey, result);
                } else if (typeof item === 'string' || typeof item === 'number' || typeof item === 'boolean') {
                    // For primitive values, use indexed keys: key[0], key[1], etc.
                    result[`${fullKey}[${index}]`] = item;
                }
            });
        } else if (typeof value === 'object') {
            // For objects, recursively flatten
            flattenObject(value, fullKey, result);
        } else {
            // For primitive values, add directly
            result[fullKey] = value;
        }
    }
    return result;
}
